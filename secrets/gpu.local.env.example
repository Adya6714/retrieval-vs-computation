# Copy to secrets/gpu.local.env and fill in. That file is gitignored — never commit it.
#
#   cp secrets/gpu.local.env.example secrets/gpu.local.env
#
# Then:
#   source secrets/gpu.local.env
#   ssh "$GPU_SSH"

# e.g. adya@gpu01.lab.example.edu  OR  adya@10.12.34.56
GPU_USER=YOUR_USERNAME
GPU_HOST=HOSTNAME_OR_IP
GPU_PORT=22
GPU_SSH="${GPU_USER}@${GPU_HOST}"

# Optional password auth (prefer SSH keys). Quote if it has special chars.
# GPU_PASSWORD='your_password_here'

# Optional: path to key if not using default ~/.ssh/id_ed25519
# GPU_IDENTITY=~/.ssh/id_ed25519

# Optional: remote working dir once cloned on the box
# REMOTE_RVC_DIR=~/rvc

# HuggingFace token (Llama-3.1 is gated — accept license on HF, then put token here)
# HF_TOKEN=hf_xxxxxxxx
